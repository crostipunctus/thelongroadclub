<% content_for :title, "#{@user.name} — The Long Road Club" %>
<div class="site-shell inner-page"><%= render "shared/inner_header" %><main class="page-wrap"><section class="profile-hero"><span class="profile-avatar avatar--<%= @user.avatar_color %>"><%= @user.initials %></span><div><div class="eyebrow"><span></span> CLUB MEMBER</div><h1><%= @user.name %><% if @user.verified? %><small>✓</small><% end %></h1><p>@<%= @user.username %><% if @user.location.present? %> · <%= @user.location %><% end %></p><% if @user.bio.present? %><div class="profile-bio"><%= @user.bio %></div><% end %></div><div class="profile-stats"><strong><%= @user.discussions.count %></strong><span>discussions</span><strong><%= @user.posts.count %></strong><span>replies</span></div></section><section class="profile-discussions"><div class="section-heading"><div><div class="eyebrow eyebrow--small"><span></span> RECENT ACTIVITY</div><h2>Discussions</h2></div></div><% @discussions.each do |discussion| %><article class="profile-thread"><div><span class="category category--<%= discussion.category.color %>"><%= discussion.category.name %></span><h3><%= link_to discussion.title, discussion %></h3><p><%= discussion.excerpt %></p></div><small><%= pluralize(discussion.replies_count, "reply") %></small></article><% end %></section></main></div>
