<header class="site-header inner-header">
  <div class="wrap header__inner">
    <%= link_to root_path, class: "brand", aria: { label: "The Long Road Club home" } do %>
      <svg class="brand__mark" viewBox="0 0 64 64" aria-hidden="true"><circle cx="32" cy="32" r="27" fill="none" stroke="currentColor" stroke-width="4"/><circle cx="32" cy="32" r="7" fill="none" stroke="currentColor" stroke-width="4"/><path d="M8 29h17m14 0h17M28 37l-9 17m17-17 9 17" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round"/></svg>
      <span class="brand__type">THE LONG ROAD <em>CLUB</em></span>
    <% end %>
    <nav class="main-nav inner-nav" aria-label="Main navigation">
      <%= link_to "Discussions", discussions_path %>
      <%= link_to "Garage", garage_features_path %>
      <%= link_to "Events", events_path %>
      <%= link_to "Guides", guides_path %>
    </nav>
    <div class="header__actions account-actions">
      <% if signed_in? %>
        <%= link_to "Start a discussion", new_discussion_path, class: "button button--dark" %>
        <%= link_to current_user.initials, user_path(current_user), class: "account-chip", title: current_user.name %>
      <% else %>
        <%= link_to "Sign in", login_path, class: "text-link" %>
        <%= link_to "Join the club", signup_path, class: "button button--dark" %>
      <% end %>
    </div>
  </div>
</header>
