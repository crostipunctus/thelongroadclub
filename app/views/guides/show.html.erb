<% content_for :title, "#{@guide.title} — The Long Road Club" %>
<div class="site-shell inner-page"><%= render "shared/inner_header" %><main class="page-wrap page-wrap--article"><div class="article-hero article-hero--guide"><div><div class="eyebrow"><span></span> <%= @guide.section.upcase %> · <%= @guide.read_time_minutes %> MIN READ</div><h1><%= @guide.title %></h1><p><%= @guide.summary %></p><div class="post-author"><span class="avatar avatar--<%= @guide.user.avatar_color %>"><%= @guide.user.initials %></span><div><strong><%= @guide.user.name %></strong><small>Published <%= @guide.published_at.strftime("%d %B %Y") %></small></div></div></div></div><article class="article-body article-body--single"><div class="prose prose--article"><%= simple_format(@guide.body) %></div></article></main></div>
