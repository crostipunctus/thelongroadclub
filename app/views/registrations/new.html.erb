<% content_for :title, "Join the Club — The Long Road Club" %>
<div class="site-shell inner-page">
  <%= render "shared/inner_header" %>
  <main class="auth-page">
    <div class="auth-card">
      <div class="eyebrow"><span></span> MEMBERSHIP</div>
      <h1>Join the long road.</h1>
      <p>Create your driver profile, join discussions, save useful threads, and RSVP to community drives.</p>
      <%= render "shared/errors", record: @user %>
      <%= form_with model: @user, url: registration_path, class: "club-form" do |form| %>
        <div class="form-grid form-grid--two">
          <label><span>Your name</span><%= form.text_field :name, required: true, autocomplete: "name" %></label>
          <label><span>Username</span><%= form.text_field :username, required: true, autocomplete: "username", placeholder: "road_runner" %></label>
        </div>
        <label><span>Email</span><%= form.email_field :email, required: true, autocomplete: "email" %></label>
        <label><span>Home base <small>(optional)</small></span><%= form.text_field :location, placeholder: "Pune, Maharashtra" %></label>
        <div class="form-grid form-grid--two">
          <label><span>Password</span><%= form.password_field :password, required: true, autocomplete: "new-password", minlength: 8 %></label>
          <label><span>Confirm password</span><%= form.password_field :password_confirmation, required: true, autocomplete: "new-password" %></label>
        </div>
        <%= form.submit "Create membership", class: "button button--orange form-submit" %>
      <% end %>
      <p class="auth-switch">Already a member? <%= link_to "Sign in", login_path %></p>
    </div>
  </main>
</div>
