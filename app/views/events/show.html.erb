<% content_for :title, "#{@event.title} — The Long Road Club" %>
<div class="site-shell inner-page"><%= render "shared/inner_header" %><main class="page-wrap page-wrap--article"><div class="article-hero"><div class="date-block date-block--large"><strong><%= @event.starts_at.strftime("%d") %></strong><span><%= @event.starts_at.strftime("%b").upcase %></span></div><div><div class="eyebrow"><span></span> CLUB EVENT</div><h1><%= @event.title %></h1><p><%= @event.location %> · <%= @event.starts_at.strftime("%A, %d %B %Y at %H:%M") %></p></div></div><article class="article-body"><div class="prose"><%= simple_format(@event.description) %></div><aside class="action-panel"><strong><%= pluralize(@event.rsvps_count, "driver") %> going</strong><span><%= @event.capacity ? "#{@event.capacity - @event.rsvps_count} places remaining" : "Open attendance" %></span><% if signed_in? %><% if @rsvp %><p>You’re marked as <strong><%= @rsvp.status %></strong>.</p><%= button_to "Cancel RSVP", event_rsvp_path(@event), method: :delete, class: "button button--dark" %><% else %><%= button_to "I’m going", event_rsvp_path(@event), params: { status: "going" }, class: "button button--orange" %><%= button_to "Interested", event_rsvp_path(@event), params: { status: "interested" }, class: "text-button" %><% end %><% else %><%= link_to "Sign in to RSVP", login_path, class: "button button--orange" %><% end %></aside></article></main></div>
