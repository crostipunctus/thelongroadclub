<% content_for :title, "Events — The Long Road Club" %>
<div class="site-shell inner-page"><%= render "shared/inner_header" %><main class="page-wrap"><div class="listing-heading"><div><div class="eyebrow"><span></span> MEET THE COMMUNITY</div><h1>Upcoming drives</h1><p>Dawn runs, cars and coffee, track days, and unhurried weekends on good roads.</p></div></div><div class="card-grid"><% @events.each do |event| %><article class="content-card event-card"><div class="date-block"><strong><%= event.starts_at.strftime("%d") %></strong><span><%= event.starts_at.strftime("%b").upcase %></span></div><div><span class="card-kicker"><%= event.starts_at.strftime("%A · %H:%M") %></span><h2><%= link_to event.title, event %></h2><p><%= event.description.truncate(170) %></p><small><%= event.location %> · <%= pluralize(event.rsvps_count, "driver") %> going</small></div></article><% end %></div></main></div>
